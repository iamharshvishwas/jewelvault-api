{
  "name": "jewelvault-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JewelVault backend: Node.js + MariaDB 11.8 (spike first, then schema)",
  "scripts": {
    "db:up": "bash scripts/db-up.sh",
    "db:down": "bash scripts/db-down.sh",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "db:schema": "node scripts/build-schema.mjs",
    "db:import": "node scripts/import-cli.mjs",
    "test:schema": "vitest run tests/schema"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  }
}
