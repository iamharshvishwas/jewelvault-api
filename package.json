{
  "name": "jewelvault-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JewelVault backend: Node.js + MariaDB 11.8 (database half first, then the API)",
  "engines": {
    "node": ">=24.7"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "check:routes": "node scripts/check-routes.mjs",
    "check:static": "JV_REQUIRE_STATEMENT_LOG=1 vitest run tests/api/static-",
    "verify": "npm run typecheck && npm run build && npm run check:routes && rm -rf node_modules/.cache/jv-statement-log && JV_STATEMENT_LOG=node_modules/.cache/jv-statement-log npm test && npm run check:static",
    "test": "vitest run",
    "test:schema": "vitest run tests/schema",
    "db:lane": "node scripts/lane.mjs",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "bash scripts/db-down.sh",
    "db:migrate": "node scripts/migrate.mjs",
    "db:schema": "node scripts/build-schema.mjs",
    "db:import": "node scripts/import-cli.mjs",
    "seed:volume": "node scripts/seed-volume.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
