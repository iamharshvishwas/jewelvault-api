# Names only. Copy to .env for a run on your own Mac; on Hostinger the same names are set in the Node.js app's environment variables (hPanel).
# .env is never committed (.gitignore). The API refuses to start when a required variable is missing.

# Required: the database (spec A3, U10)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional
# PORT=3000
# LOG_LEVEL=info
