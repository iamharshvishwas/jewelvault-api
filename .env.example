# Names only. Copy to .env for a run on your own Mac; on Hostinger the same names are set in the Node.js app's environment variables (hPanel).
# .env is never committed (.gitignore). The API refuses to start when a required variable is missing.

# Required: the database (spec A3, U10)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Required: the origins that may call the API from a browser (spec A12), comma separated, each exactly as the browser writes it: https://host (or http://localhost:port on your own Mac).
# In production only the website's address. Never *, no patterns, no trailing slash, no preview addresses.
ALLOWED_ORIGINS=

# Optional: the admin door (spec U3, O41). The SHA-256 of the admin token in hex, 64 characters: `npm run make-token` prints the token once (keep it in your head or a password manager, never in
# a file) and this hash. The door /admin/v1/* exists only while this is set; after the first owner exists, remove it until you need it again. Never put the token itself here.
# JV_ADMIN_TOKEN_HASH=

# Optional
# PORT=3000
# LOG_LEVEL=info
